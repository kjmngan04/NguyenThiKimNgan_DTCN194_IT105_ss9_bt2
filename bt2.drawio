        <mxCell id="R1LQH20Cy0uhE7zSD2zA-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h3 dir=&quot;auto&quot; class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;Phần 1 — Xác định thiếu sót&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/h3&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;br/&gt;&lt;p dir=&quot;auto&quot;&gt;Sơ đồ hiện tại &lt;strong&gt;chưa mô tả đầy đủ nghiệp vụ&lt;/strong&gt; vì chỉ thể hiện một trường hợp xác thực OTP, trong khi theo yêu cầu:&lt;/p&gt;&lt;br/&gt;&lt;ul&gt;&lt;br/&gt;&lt;li&gt;&lt;br/&gt;OTP chỉ có &lt;strong&gt;2 khả năng&lt;/strong&gt;: đúng hoặc sai.&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li&gt;&lt;br/&gt;Hai khả năng này phải được biểu diễn bằng &lt;strong&gt;Combined Fragment &lt;code&gt;alt&lt;/code&gt;&lt;/strong&gt;.&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li&gt;&lt;br/&gt;Nhánh thứ nhất: &lt;code&gt;[OTP đúng]&lt;/code&gt;.&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;li&gt;&lt;br/&gt;Nhánh thứ hai: &lt;code&gt;else [OTP sai]&lt;/code&gt;.&lt;br/&gt;&lt;/li&gt;&lt;br/&gt;&lt;/ul&gt;&lt;br/&gt;&lt;p dir=&quot;auto&quot;&gt;Nếu chỉ có nhánh OTP đúng thì khi OTP sai, Sequence Diagram &lt;strong&gt;không cho biết hệ thống phải phản hồi như thế nào&lt;/strong&gt;.&lt;/p&gt;&lt;/h1&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="309" y="220" as="geometry" />
        </mxCell>
